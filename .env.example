# Example environment configuration for Printer Maintenance Application
# Copy this file to .env and adjust the values for your setup

# Required: Your printer's IP address
PRINTER_IP=192.168.1.100

# Required: Your ntfy.sh channel for notifications
NTFY_CHANNEL=printer-maintenance

# Optional: Printer name for display (default: HP Smart Tank 7005)
PRINTER_NAME=HP Smart Tank 7005

# Optional: SNMP community string (default: public)
SNMP_COMMUNITY=public

# Optional: Output path for PDFs (default: /tmp/printer-output/printer-test.pdf)
OUTPUT_PATH=/tmp/printer-output/printer-test.pdf

# Optional: Timezone for cron scheduling (default: UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo
TZ=UTC

# Optional: Cron schedule for printer maintenance (default: 0 2 * * 0 - Sunday at 2:00 AM)
# Format: minute hour day month weekday
# Examples:
#   0 3 * * * - Daily at 3:00 AM
#   0 9 * * 1 - Every Monday at 9:00 AM
#   0 2 * * 1,4 - Monday and Thursday at 2:00 AM
CRON_SCHEDULE=0 2 * * 0

# Optional: Printer URI for CUPS setup (default: ipp://{PRINTER_IP}/ipp/print)
# Examples:
#   ipp://192.168.1.100/ipp/print
#   lpd://192.168.1.100/queue
#PRINTER_URI=

# Optional: Printer driver for CUPS (default: everywhere)
# The 'everywhere' driver uses IPP Everywhere / AirPrint
# Other options: lsb/usr/cupsfilters/textonly.ppd, raw, etc.
PRINTER_DRIVER=everywhere

# Optional: Set printer as default in CUPS (default: true)
PRINTER_SET_DEFAULT=true

# Optional: Enable duplex (double-sided) printing (default: false)
PRINT_DUPLEX=false
