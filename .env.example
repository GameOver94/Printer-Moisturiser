# Example environment configuration for Printer Maintenance Application
# Copy this file to .env and adjust the values for your setup

# Required: Your printer's IP address
PRINTER_IP=192.168.1.100

# Required: Your ntfy.sh channel for notifications
NTFY_CHANNEL=printer-maintenance

# Optional: Printer name for display (default: HP Smart Tank 7005)
PRINTER_NAME=HP Smart Tank 7005

# Optional: SNMP community string (default: public)
SNMP_COMMUNITY=public

# Optional: Output path for PDFs (default: /tmp/printer-output/printer-test.pdf)
OUTPUT_PATH=/tmp/printer-output/printer-test.pdf

# Optional: Timezone for cron scheduling (default: UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo
TZ=UTC
